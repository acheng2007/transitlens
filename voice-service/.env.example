XAI_API_KEY=

# Defaults: direct xAI, grok-4.3. (grok-4-fast was retired by xAI on 2026-05-15.)
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-4.3
# grok-4.3 reasons at "low" effort by default; "none" skips reasoning for the fastest spoken answers.
# Only set this for providers that support it (xAI does; leave it unset for Gemini).
# XAI_REASONING_EFFORT=none

# Grok text-to-speech for spoken answers (POST /api/voice/speak). Voices: eve | ara | leo | rex | sal.
# Uses XAI_API_KEY when XAI_BASE_URL points at x.ai; otherwise set XAI_TTS_API_KEY to an xAI key.
# XAI_TTS_VOICE=leo
# XAI_TTS_API_KEY=

# To use OpenRouter instead, put your OpenRouter key in XAI_API_KEY and set:
# XAI_BASE_URL=https://openrouter.ai/api/v1
# XAI_MODEL=<current Grok id from openrouter.ai/models, e.g. x-ai/...>

# To use Gemini (free tier) instead, put your Google AI Studio key in XAI_API_KEY and set:
# XAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# XAI_MODEL=gemini-3.5-flash-lite   # ~0.6s answers; gemini-3.8-flash is smarter but 3-5s and flaky
