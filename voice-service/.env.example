GEMINI_API_KEY=
# Existing text SDK model with JSON structured output and minimal thinking support.
GEMINI_MODEL=gemini-3.5-flash-lite
# No automatic retries or model fallback. TTS uses gemini-3.8-flash-lite-tts / Sulafat.
GEMINI_TTS_GENERATIONS_PER_MINUTE=10
# Free usage requires a Google project marked Free tier; settings cannot force free billing.
BUS_SERVICE_URL=http://127.0.0.1:8003
